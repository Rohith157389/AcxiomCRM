@model AcxiomCRM.ViewModels.CustomerFormViewModel

@{
    ViewData["Title"] = "Add customer";
}

<div class="mb-4">
    <h1 class="h2">Add customer</h1>
    <p class="text-secondary">Create a customer record owned by your authenticated account.</p>
</div>

<form asp-action="Create" method="post" class="card card-body shadow-sm border-0">
    <partial name="_CustomerForm" model="Model" />
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Save customer</button>
        <a asp-action="Customers" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
