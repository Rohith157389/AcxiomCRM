@model AcxiomCRM.ViewModels.OpportunityFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-8"><label asp-for="OpportunityName" class="form-label"></label><input asp-for="OpportunityName" class="form-control" /><span asp-validation-for="OpportunityName" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" type="number" step="0.01" min="0" /><span asp-validation-for="Amount" class="text-danger"></span></div><div class="col-md-6"><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" class="form-select"><option value="">Select customer</option>@foreach (var item in Model.Customers) { <option value="@item.Id">@item.DisplayName</option> }</select><span asp-validation-for="CustomerId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="LeadId" class="form-label">Lead (optional)</label><select asp-for="LeadId" class="form-select"><option value="">None</option>@foreach (var item in Model.Leads) { <option value="@item.Id">@item.DisplayName</option> }</select><span asp-validation-for="LeadId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" class="form-select">@foreach (var item in new[] { "Qualification", "Proposal", "Negotiation", "Won", "Lost" }) { <option value="@item">@item</option> }</select><span asp-validation-for="Stage" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" class="form-control" type="number" step="0.01" min="0" max="100" /><span asp-validation-for="Probability" class="text-danger"></span></div><div class="col-md-4"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" class="form-control" type="date" /><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select">@foreach (var item in new[] { "Open", "Won", "Lost" }) { <option value="@item">@item</option> }</select><span asp-validation-for="Status" class="text-danger"></span></div>@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <div class="col-md-8"><label asp-for="AssignedTo" class="form-label">Assigned to</label><select asp-for="AssignedTo" class="form-select"><option value="">Assign to me</option>@foreach (var item in Model.Assignees) { <option value="@item.Id">@item.DisplayName</option> }</select><span asp-validation-for="AssignedTo" class="text-danger"></span></div> }</div>
