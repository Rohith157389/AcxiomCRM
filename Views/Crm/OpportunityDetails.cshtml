@model AcxiomCRM.ViewModels.OpportunityFormViewModel
@{ ViewData["Title"] = "Opportunity Details"; }<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h2">Opportunity details</h1><div><a asp-action="EditOpportunity" asp-route-id="@Model.OpportunityId" class="btn btn-primary">Edit</a> <a asp-action="Opportunities" class="btn btn-outline-secondary">Back</a></div></div><div class="card shadow-sm border-0"><div class="card-body"><dl class="row mb-0"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.OpportunityName</dd><dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@Model.CustomerName</dd><dt class="col-sm-3">Lead</dt><dd class="col-sm-9">@(Model.LeadName ?? "—")</dd><dt class="col-sm-3">Stage</dt><dd class="col-sm-9"><span class="badge text-bg-light border">@Model.Stage</span></dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Amount</dt><dd class="col-sm-9">@Model.Amount.ToString("C")</dd><dt class="col-sm-3">Probability</dt><dd class="col-sm-9">@Model.Probability.ToString("0.##")%</dd><dt class="col-sm-3">Weighted pipeline</dt><dd class="col-sm-9 fw-semibold">@Model.WeightedValue.ToString("C")</dd><dt class="col-sm-3">Expected close</dt><dd class="col-sm-9">@(Model.ExpectedCloseDate?.ToString("d") ?? "—")</dd><dt class="col-sm-3">Assigned to</dt><dd class="col-sm-9">@(Model.AssignedToName ?? "Unassigned")</dd></dl></div></div>
