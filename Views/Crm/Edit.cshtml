@model AcxiomCRM.ViewModels.CustomerFormViewModel

@{
    ViewData["Title"] = "Edit customer";
}

<div class="mb-4">
    <h1 class="h2">Edit customer</h1>
    <p class="text-secondary">Update the customer record without changing its owner or creation metadata.</p>
</div>

<form asp-action="Edit" asp-route-id="@Model.CustomerId" method="post" class="card card-body shadow-sm border-0">
    <input asp-for="CustomerId" type="hidden" />
    <partial name="_CustomerForm" model="Model" />
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
