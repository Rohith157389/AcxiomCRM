@model AcxiomCRM.ViewModels.FollowUpFormViewModel
@{ ViewData["Title"] = "Follow-up Details"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h2">Follow-up details</h1><div><a asp-action="CreateActivity" asp-route-customerId="@Model.CustomerId" asp-route-leadId="@Model.LeadId" class="btn btn-outline-success">Record activity</a> <a asp-action="EditFollowUp" asp-route-id="@Model.FollowUpId" class="btn btn-primary">Edit</a> <a asp-action="FollowUps" class="btn btn-outline-secondary">Back</a></div></div>
<div class="card shadow-sm border-0"><div class="card-body"><dl class="row mb-0"><dt class="col-sm-3">Customer</dt><dd class="col-sm-9">@(Model.CustomerName ?? "—")</dd><dt class="col-sm-3">Lead</dt><dd class="col-sm-9">@(Model.LeadName ?? "—")</dd><dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.FollowUpDate.ToLocalTime().ToString("f")</dd><dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.FollowUpType</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Assigned to</dt><dd class="col-sm-9">@(Model.AssignedToName ?? "Unassigned")</dd><dt class="col-sm-3">Remarks</dt><dd class="col-sm-9">@Model.Remarks</dd></dl></div></div>
