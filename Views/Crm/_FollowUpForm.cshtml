@model AcxiomCRM.ViewModels.FollowUpFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-6"><label asp-for="CustomerId" class="form-label">Customer (optional if Lead selected)</label><select asp-for="CustomerId" class="form-select"><option value="">None</option>@foreach (var item in Model.Customers) { <option value="@item.Id">@item.DisplayName</option> }</select><span asp-validation-for="CustomerId" class="text-danger"></span></div><div class="col-md-6"><label asp-for="LeadId" class="form-label">Lead (optional if Customer selected)</label><select asp-for="LeadId" class="form-select"><option value="">None</option>@foreach (var item in Model.Leads) { <option value="@item.Id">@item.DisplayName</option> }</select><span asp-validation-for="LeadId" class="text-danger"></span></div><div class="col-md-4"><label asp-for="FollowUpDate" class="form-label"></label><input asp-for="FollowUpDate" class="form-control" type="datetime-local" value="@Model.FollowUpDate.ToString("yyyy-MM-ddTHH:mm")" /><span asp-validation-for="FollowUpDate" class="text-danger"></span></div><div class="col-md-4"><label asp-for="FollowUpType" class="form-label"></label><select asp-for="FollowUpType" class="form-select">@foreach (var item in new[] { "Call", "Meeting", "Email", "Task" }) { <option value="@item">@item</option> }</select><span asp-validation-for="FollowUpType" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select">@foreach (var item in new[] { "Planned", "Completed", "Missed", "Cancelled" }) { <option value="@item">@item</option> }</select><span asp-validation-for="Status" class="text-danger"></span></div><div class="col-12"><label asp-for="Remarks" class="form-label"></label><textarea asp-for="Remarks" class="form-control" rows="3"></textarea><span asp-validation-for="Remarks" class="text-danger"></span></div>@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <div class="col-md-6"><label asp-for="AssignedTo" class="form-label">Assigned to</label><select asp-for="AssignedTo" class="form-select"><option value="">Assign to me</option>@foreach (var item in Model.Assignees) { <option value="@item.Id">@item.DisplayName</option> }</select><span asp-validation-for="AssignedTo" class="text-danger"></span></div> }</div>
