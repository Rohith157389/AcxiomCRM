@model AcxiomCRM.ViewModels.FollowUpFormViewModel
@{ ViewData["Title"] = "Delete Follow-up"; }
<div class="card border-danger shadow-sm"><div class="card-body"><h1 class="h3 text-danger">Delete follow-up?</h1><p>This will permanently delete the @Model.FollowUpType follow-up scheduled for <strong>@Model.FollowUpDate.ToLocalTime().ToString("g")</strong>.</p><form asp-action="DeleteFollowUp" asp-route-id="@Model.FollowUpId" method="post"><button class="btn btn-danger" type="submit">Delete follow-up</button> <a asp-action="FollowUpDetails" asp-route-id="@Model.FollowUpId" class="btn btn-outline-secondary">Cancel</a></form></div></div>
