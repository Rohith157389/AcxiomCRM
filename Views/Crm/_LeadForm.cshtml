@model AcxiomCRM.ViewModels.LeadFormViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3">
<div class="col-md-4"><label asp-for="LeadCode" class="form-label"></label><input asp-for="LeadCode" class="form-control" /><span asp-validation-for="LeadCode" class="text-danger"></span></div><div class="col-md-8"><label asp-for="LeadName" class="form-label"></label><input asp-for="LeadName" class="form-control" /><span asp-validation-for="LeadName" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" type="email" /><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" type="tel" /><span asp-validation-for="Phone" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control" /><span asp-validation-for="CompanyName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Source" class="form-label"></label><input asp-for="Source" class="form-control" /><span asp-validation-for="Source" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="ExpectedValue" class="form-label"></label><input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="0" /><span asp-validation-for="ExpectedValue" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select">@foreach (var item in new[] { "New", "Contacted", "Qualified", "Unqualified", "Converted", "Lost" }) { <option value="@item">@item</option> }</select><span asp-validation-for="Status" class="text-danger"></span></div>
@if (User.IsInRole("Admin") || User.IsInRole("Manager")) { <div class="col-md-4"><label asp-for="AssignedTo" class="form-label">Assigned to</label><select asp-for="AssignedTo" class="form-select"><option value="">Assign to me</option>@foreach (var user in Model.Assignees) { <option value="@user.Id">@user.DisplayName</option> }</select><span asp-validation-for="AssignedTo" class="text-danger"></span></div> }
</div>
