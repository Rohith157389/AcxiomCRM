@model AcxiomCRM.ViewModels.ReportsViewModel
@{
    ViewData["Title"] = "Reports";
    var labels = new Dictionary<string, string> { ["Customer"] = "Customer Report", ["Lead"] = "Lead Report", ["FollowUp"] = "Follow-up Report", ["Opportunity"] = "Opportunity Report", ["Pipeline"] = "Pipeline Report", ["LeadConversion"] = "Lead Conversion Report", ["UserActivity"] = "User Activity Report", ["AuditLog"] = "Audit Log Report" };
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><h1 class="h2">@labels.GetValueOrDefault(Model.ReportType, "Reports")</h1><p class="text-secondary mb-0">Reports use the same role-based scope as CRM records.</p></div><a class="btn btn-outline-success" asp-action="ExportReport" asp-route-reportType="@Model.ReportType" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-sort="@Model.Sort">Export CSV</a></div>
<form method="get" class="card card-body border-0 shadow-sm mb-4"><div class="row g-3 align-items-end"><div class="col-md-3"><label class="form-label">Report</label><select name="reportType" class="form-select">@foreach (var type in Model.ReportTypes) { <option value="@type" selected="@(type == Model.ReportType)">@labels.GetValueOrDefault(type, type)</option> }</select></div><div class="col-md-3"><label class="form-label">Search</label><input name="search" value="@Model.Search" class="form-control" placeholder="Search records" /></div><div class="col-md-2"><label class="form-label">Status/entity</label><select name="status" class="form-select"><option value="">All</option>@foreach (var value in Model.StatusOptions) { <option value="@value" selected="@(value == Model.Status)">@value</option> }</select></div><div class="col-md-2"><label class="form-label">From</label><input name="fromDate" type="date" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" /></div><div class="col-md-2"><label class="form-label">To</label><input name="toDate" type="date" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" /></div><div class="col-md-2"><label class="form-label">Sort</label><select name="sort" class="form-select"><option value="date_desc" selected="@(Model.Sort == "date_desc")">Newest</option><option value="name" selected="@(Model.Sort == "name")">Name</option></select></div><div class="col-12"><button class="btn btn-primary" type="submit">Filter report</button></div></div></form>
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr>@foreach (var column in Model.Columns) { <th>@column</th> }</tr></thead><tbody>@if (Model.Rows.Count == 0) { <tr><td class="text-center text-secondary py-5" colspan="@Math.Max(1, Model.Columns.Count)">No records match the selected filters.</td></tr> } else { foreach (var row in Model.Rows) { <tr>@foreach (var value in row.Values) { <td>@value</td> }</tr> } }</tbody></table></div></div>
@if (Model.TotalPages > 1) { <nav class="mt-3"><ul class="pagination">@for (var i = 1; i <= Model.TotalPages; i++) { <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" asp-action="Reports" asp-route-reportType="@Model.ReportType" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-sort="@Model.Sort" asp-route-page="@i">@i</a></li> }</ul></nav> }
