@model AcxiomCRM.ViewModels.LeadListViewModel
@{ ViewData["Title"] = "Leads"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h2 mb-1">Leads</h1><p class="text-secondary mb-0">Track prospects and convert qualified leads.</p></div><a class="btn btn-primary" asp-action="CreateLead">Add lead</a></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<form method="get" asp-action="Leads" class="card card-body shadow-sm border-0 mb-4"><div class="row g-3 align-items-end">
<div class="col-12 col-lg-4"><label class="form-label" for="search">Search</label><input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Name, email, phone or company" /></div>
<div class="col-6 col-lg-2"><label class="form-label" for="status">Status</label><select class="form-select" id="status" name="status"><option value="">All statuses</option>@foreach (var item in Model.Statuses) { <option value="@item" selected="@(Model.Status == item)">@item</option> }</select></div>
<div class="col-6 col-lg-2"><label class="form-label" for="source">Source</label><select class="form-select" id="source" name="source"><option value="">All sources</option>@foreach (var item in Model.Sources) { <option value="@item" selected="@(Model.Source == item)">@item</option> }</select></div>
@if (Model.CanFilterByAssignee) { <div class="col-12 col-lg-2"><label class="form-label" for="assignedTo">Assigned user</label><select class="form-select" id="assignedTo" name="assignedTo"><option value="">All users</option>@foreach (var user in Model.Assignees) { <option value="@user.Id" selected="@(Model.AssignedTo == user.Id)">@user.DisplayName</option> }</select></div> }
<div class="col-12 col-lg-2 d-flex gap-2"><button class="btn btn-outline-primary flex-grow-1" type="submit">Filter</button><a class="btn btn-outline-secondary" asp-action="Leads">Clear</a></div></div></form>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Code</th><th>Lead</th><th>Contact</th><th>Source</th><th>Status</th><th>Value</th><th>Assigned to</th><th class="text-end">Actions</th></tr></thead><tbody>
@if (Model.Leads.Count == 0) { <tr><td colspan="8" class="text-center text-secondary py-5">No leads match the current filters.</td></tr> } else { @foreach (var lead in Model.Leads) { <tr><td class="fw-semibold">@lead.LeadCode</td><td><a asp-action="LeadDetails" asp-route-id="@lead.LeadId" class="text-decoration-none fw-semibold">@lead.LeadName</a>@if (!string.IsNullOrWhiteSpace(lead.CompanyName)) { <div class="small text-secondary">@lead.CompanyName</div> }</td><td><div>@lead.Email</div><div class="small text-secondary">@lead.Phone</div></td><td>@lead.Source</td><td><span class="badge text-bg-light border">@lead.Status</span></td><td>@lead.ExpectedValue.ToString("C")</td><td>@lead.AssignedToName</td><td class="text-end text-nowrap"><a asp-action="LeadDetails" asp-route-id="@lead.LeadId" class="btn btn-sm btn-outline-secondary">View</a><a asp-action="EditLead" asp-route-id="@lead.LeadId" class="btn btn-sm btn-outline-primary">Edit</a>@if (lead.Status == "Qualified") { <a asp-action="ConvertLead" asp-route-id="@lead.LeadId" class="btn btn-sm btn-outline-success">Convert</a> }<a asp-action="DeleteLead" asp-route-id="@lead.LeadId" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> } }</tbody></table></div></div>
@if (Model.TotalPages > 1) { <nav class="mt-4"><ul class="pagination justify-content-center">@for (var p = 1; p <= Model.TotalPages; p++) { <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" asp-action="Leads" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-source="@Model.Source" asp-route-assignedTo="@Model.AssignedTo">@p</a></li> }</ul></nav> }
