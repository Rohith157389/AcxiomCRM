@model AcxiomCRM.ViewModels.LeadFormViewModel
@{ ViewData["Title"] = "Convert Lead"; }<div class="card border-success shadow-sm"><div class="card-body"><h1 class="h3 text-success">Convert qualified lead?</h1><p>Converting <strong>@Model.LeadName</strong> will create one customer and one opportunity, then mark the lead Converted.</p><dl class="row"><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Expected value</dt><dd class="col-sm-9">@Model.ExpectedValue.ToString("C")</dd></dl><form asp-action="ConvertLead" asp-route-id="@Model.LeadId" method="post"><button class="btn btn-success" type="submit">Confirm conversion</button> <a asp-action="Leads" class="btn btn-outline-secondary">Cancel</a></form></div></div>
