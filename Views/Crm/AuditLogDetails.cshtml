@model AcxiomCRM.ViewModels.AuditLogListItemViewModel
@{ ViewData["Title"] = "Audit Log Details"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h2">Audit log details</h1><a asp-action="AuditLogs" class="btn btn-outline-secondary">Back</a></div><div class="card shadow-sm border-0"><div class="card-body"><dl class="row"><dt class="col-sm-3">User</dt><dd class="col-sm-9">@Model.UserName</dd><dt class="col-sm-3">Action</dt><dd class="col-sm-9">@Model.Action</dd><dt class="col-sm-3">Entity</dt><dd class="col-sm-9">@Model.EntityName</dd><dt class="col-sm-3">Record ID</dt><dd class="col-sm-9">@Model.RecordId</dd><dt class="col-sm-3">Timestamp</dt><dd class="col-sm-9">@Model.CreatedDate.ToLocalTime().ToString("f")</dd><dt class="col-sm-3">IP address</dt><dd class="col-sm-9">@Model.IpAddress</dd><dt class="col-sm-3">Old value</dt><dd class="col-sm-9"><pre class="small bg-light p-3">@Model.OldValue</pre></dd><dt class="col-sm-3">New value</dt><dd class="col-sm-9"><pre class="small bg-light p-3">@Model.NewValue</pre></dd></dl></div></div>
