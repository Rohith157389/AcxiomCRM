@model AcxiomCRM.ViewModels.ActivityFormViewModel
@{ ViewData["Title"] = "Record Activity"; }
<div class="card shadow-sm border-0"><div class="card-body"><h1 class="h3 mb-4">Record related activity</h1><p class="text-secondary">Record a Call, Meeting, Email or Task against a customer or lead.</p><form asp-action="CreateActivity" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-6"><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" class="form-select"><option value="">None</option>@foreach (var item in Model.Customers) { <option value="@item.Id">@item.DisplayName</option> }</select></div><div class="col-md-6"><label asp-for="LeadId" class="form-label">Lead</label><select asp-for="LeadId" class="form-select"><option value="">None</option>@foreach (var item in Model.Leads) { <option value="@item.Id">@item.DisplayName</option> }</select></div><div class="col-md-4"><label asp-for="ActivityType" class="form-label"></label><select asp-for="ActivityType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div><div class="col-md-8"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" /><span asp-validation-for="Subject" class="text-danger"></span></div><div class="col-md-4"><label asp-for="ActivityDate" class="form-label"></label><input asp-for="ActivityDate" class="form-control" type="datetime-local" value="@Model.ActivityDate.ToString("yyyy-MM-ddTHH:mm")" /></div><div class="col-md-8"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Open</option><option>Completed</option></select></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="text-danger"></span></div></div><div class="mt-4"><button class="btn btn-primary" type="submit">Record activity</button> <a asp-action="FollowUps" class="btn btn-outline-secondary">Cancel</a></div></form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
