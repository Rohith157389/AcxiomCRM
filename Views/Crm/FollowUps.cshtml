@model AcxiomCRM.ViewModels.FollowUpListViewModel
@{ ViewData["Title"] = "Follow-ups"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h2 mb-1">Follow-ups</h1><p class="text-secondary mb-0">Plan, reschedule and complete customer or lead follow-ups.</p></div><a class="btn btn-primary" asp-action="CreateFollowUp">Add follow-up</a></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> } @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<form method="get" asp-action="FollowUps" class="card card-body shadow-sm border-0 mb-4"><div class="row g-3 align-items-end"><div class="col-12 col-lg-3"><label class="form-label" for="search">Search</label><input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Customer, lead or remarks" /></div><div class="col-6 col-lg-2"><label class="form-label" for="status">Status</label><select class="form-select" id="status" name="status"><option value="">All statuses</option>@foreach (var item in Model.Statuses) { <option value="@item" selected="@(Model.Status == item)">@item</option> }</select></div><div class="col-6 col-lg-2"><label class="form-label" for="followUpType">Type</label><select class="form-select" id="followUpType" name="followUpType"><option value="">All types</option>@foreach (var item in Model.FollowUpTypes) { <option value="@item" selected="@(Model.FollowUpType == item)">@item</option> }</select></div><div class="col-6 col-lg-1"><label class="form-label" for="fromDate">From</label><input class="form-control" id="fromDate" name="fromDate" type="date" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" /></div><div class="col-6 col-lg-1"><label class="form-label" for="toDate">To</label><input class="form-control" id="toDate" name="toDate" type="date" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" /></div>@if (Model.CanFilterByAssignee) { <div class="col-12 col-lg-2"><label class="form-label" for="assignedTo">Assigned user</label><select class="form-select" id="assignedTo" name="assignedTo"><option value="">All users</option>@foreach (var item in Model.Assignees) { <option value="@item.Id" selected="@(Model.AssignedTo == item.Id)">@item.DisplayName</option> }</select></div> }<div class="col-12 col-lg-1 d-flex gap-2"><button class="btn btn-outline-primary" type="submit">Filter</button></div></div></form>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Date</th><th>Related to</th><th>Type</th><th>Remarks</th><th>Status</th><th>Assigned to</th><th class="text-end">Actions</th></tr></thead><tbody>@if (Model.FollowUps.Count == 0) { <tr><td colspan="7" class="text-center text-secondary py-5">No follow-ups match the current filters.</td></tr> } else { @foreach (var item in Model.FollowUps) { <tr class="@(item.IsOverdue ? "table-warning" : "")"><td><a asp-action="FollowUpDetails" asp-route-id="@item.FollowUpId" class="text-decoration-none">@item.FollowUpDate.ToLocalTime().ToString("g")</a>@if (item.IsOverdue) { <div class="small text-danger fw-semibold">Overdue</div> } else if (item.Status == "Planned") { <div class="small text-success">Upcoming</div> }</td><td>@if (!string.IsNullOrWhiteSpace(item.CustomerName)) { <div>@item.CustomerName</div> } @if (!string.IsNullOrWhiteSpace(item.LeadName)) { <div class="small text-secondary">@item.LeadName</div> }</td><td>@item.FollowUpType</td><td>@item.Remarks</td><td><span class="badge @(item.Status == "Completed" ? "text-bg-success" : item.Status == "Cancelled" ? "text-bg-secondary" : item.Status == "Missed" ? "text-bg-danger" : "text-bg-primary")">@item.Status</span></td><td>@item.AssignedToName</td><td class="text-end text-nowrap"><a asp-action="FollowUpDetails" asp-route-id="@item.FollowUpId" class="btn btn-sm btn-outline-secondary">View</a> <a asp-action="EditFollowUp" asp-route-id="@item.FollowUpId" class="btn btn-sm btn-outline-primary">Edit</a>@if (item.Status == "Planned" || item.Status == "Missed") { <form asp-action="CompleteFollowUp" asp-route-id="@item.FollowUpId" method="post" class="d-inline"><button class="btn btn-sm btn-outline-success" type="submit">Complete</button></form> }<a asp-action="DeleteFollowUp" asp-route-id="@item.FollowUpId" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> } }</tbody></table></div></div>
@if (Model.TotalPages > 1) { <nav class="mt-4"><ul class="pagination justify-content-center">@for (var p = 1; p <= Model.TotalPages; p++) { <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" asp-action="FollowUps" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-followUpType="@Model.FollowUpType" asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-assignedTo="@Model.AssignedTo">@p</a></li> }</ul></nav> }
