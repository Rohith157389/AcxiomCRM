@model AcxiomCRM.ViewModels.UserListViewModel
@{ ViewData["Title"] = "Users"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h2 mb-1">Users</h1><p class="text-secondary mb-0">Manage Identity accounts and CRM roles.</p></div><a class="btn btn-primary" asp-action="CreateUser">Create user</a></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> } @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<form method="get" asp-action="Users" class="card card-body shadow-sm border-0 mb-4"><div class="row g-3 align-items-end"><div class="col-md-10"><label class="form-label" for="search">Search email or username</label><input class="form-control" id="search" name="search" value="@Model.Search" /></div><div class="col-md-2"><button class="btn btn-outline-primary w-100" type="submit">Search</button></div></div></form>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Email</th><th>Username</th><th>Role</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>@if (Model.Users.Count == 0) { <tr><td colspan="5" class="text-center text-secondary py-5">No users found.</td></tr> } else { @foreach (var user in Model.Users) { <tr><td>@user.Email</td><td>@user.UserName</td><td><span class="badge text-bg-light border">@user.Role</span></td><td><span class="badge @(user.IsActive ? "text-bg-success" : "text-bg-secondary")">@(user.IsActive ? "Active" : "Inactive")</span></td><td class="text-end"><a asp-action="UserDetails" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">View</a> <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Manage</a></td></tr> } }</tbody></table></div></div>
@if (Model.TotalPages > 1) { <nav class="mt-4"><ul class="pagination justify-content-center">@for (var p = 1; p <= Model.TotalPages; p++) { <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" asp-action="Users" asp-route-page="@p" asp-route-search="@Model.Search">@p</a></li> }</ul></nav> }
