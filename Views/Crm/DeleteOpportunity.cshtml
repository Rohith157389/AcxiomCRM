@model AcxiomCRM.ViewModels.OpportunityFormViewModel
@{ ViewData["Title"] = "Delete Opportunity"; }<div class="card border-danger shadow-sm"><div class="card-body"><h1 class="h3 text-danger">Delete opportunity?</h1><p>This will permanently delete <strong>@Model.OpportunityName</strong> linked to <strong>@Model.CustomerName</strong>.</p><form asp-action="DeleteOpportunity" asp-route-id="@Model.OpportunityId" method="post"><button class="btn btn-danger" type="submit">Delete opportunity</button> <a asp-action="OpportunityDetails" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary">Cancel</a></form></div></div>
