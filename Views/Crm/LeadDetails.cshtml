@model AcxiomCRM.ViewModels.LeadFormViewModel
@{ ViewData["Title"] = "Lead Details"; }<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h2">Lead details</h1><div><a asp-action="EditLead" asp-route-id="@Model.LeadId" class="btn btn-primary">Edit</a> <a asp-action="Leads" class="btn btn-outline-secondary">Back</a></div></div><div class="card shadow-sm border-0"><div class="card-body"><dl class="row mb-0"><dt class="col-sm-3">Code</dt><dd class="col-sm-9">@Model.LeadCode</dd><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.LeadName</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.CompanyName</dd><dt class="col-sm-3">Source</dt><dd class="col-sm-9">@Model.Source</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge text-bg-light border">@Model.Status</span></dd><dt class="col-sm-3">Expected value</dt><dd class="col-sm-9">@Model.ExpectedValue.ToString("C")</dd><dt class="col-sm-3">Assigned to</dt><dd class="col-sm-9">@(Model.AssignedToName ?? "Unassigned")</dd><dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedDate.ToLocalTime()</dd></dl></div></div>
