@model AcxiomCRM.ViewModels.CustomerFormViewModel

@{
    ViewData["Title"] = "Customer details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">@Model.CustomerName</h1>
        <p class="text-secondary mb-0">Customer code: @Model.CustomerCode</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.CustomerId" class="btn btn-primary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.CustomerId" class="btn btn-outline-danger">Delete</a>
        <a asp-action="Customers" class="btn btn-outline-secondary">Back</a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd>
            <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@(Model.Phone ?? "—")</dd>
            <dt class="col-sm-3">Company</dt><dd class="col-sm-9">@(Model.CompanyName ?? "—")</dd>
            <dt class="col-sm-3">Address</dt><dd class="col-sm-9">@(Model.Address ?? "—")</dd>
            <dt class="col-sm-3">City / State</dt><dd class="col-sm-9">@Model.City@(string.IsNullOrWhiteSpace(Model.State) ? string.Empty : $" / {Model.State}")</dd>
            <dt class="col-sm-3">Created date</dt><dd class="col-sm-9">@Model.CreatedDate.ToLocalTime().ToString("g")</dd>
            <dt class="col-sm-3">Owner</dt><dd class="col-sm-9">@Model.CreatedByName</dd>
        </dl>
    </div>
</div>
