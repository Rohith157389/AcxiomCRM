@model AcxiomCRM.ViewModels.OpportunityListViewModel
@{ ViewData["Title"] = "Opportunities"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h2 mb-1">Opportunities</h1><p class="text-secondary mb-0">Manage active pipeline and closed outcomes.</p></div><a class="btn btn-primary" asp-action="CreateOpportunity">Add opportunity</a></div>
@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> } @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="row g-3 mb-4"><div class="col-md-6"><div class="card shadow-sm border-0"><div class="card-body"><div class="text-secondary small">Active pipeline</div><div class="h3 mb-0">@Model.TotalAmount.ToString("C")</div></div></div></div><div class="col-md-6"><div class="card shadow-sm border-0"><div class="card-body"><div class="text-secondary small">Weighted pipeline</div><div class="h3 mb-0">@Model.WeightedPipeline.ToString("C")</div></div></div></div></div>
<form method="get" asp-action="Opportunities" class="card card-body shadow-sm border-0 mb-4"><div class="row g-3 align-items-end"><div class="col-12 col-lg-4"><label class="form-label" for="search">Search</label><input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Opportunity or customer name" /></div><div class="col-6 col-lg-2"><label class="form-label" for="stage">Stage</label><select class="form-select" id="stage" name="stage"><option value="">All stages</option>@foreach (var item in Model.Stages) { <option value="@item" selected="@(Model.Stage == item)">@item</option> }</select></div><div class="col-6 col-lg-2"><label class="form-label" for="status">Status</label><select class="form-select" id="status" name="status"><option value="">All statuses</option>@foreach (var item in Model.Statuses) { <option value="@item" selected="@(Model.Status == item)">@item</option> }</select></div>@if (Model.CanFilterByAssignee) { <div class="col-12 col-lg-2"><label class="form-label" for="assignedTo">Assigned user</label><select class="form-select" id="assignedTo" name="assignedTo"><option value="">All users</option>@foreach (var user in Model.Assignees) { <option value="@user.Id" selected="@(Model.AssignedTo == user.Id)">@user.DisplayName</option> }</select></div> }<div class="col-12 col-lg-2 d-flex gap-2"><button class="btn btn-outline-primary flex-grow-1" type="submit">Filter</button><a class="btn btn-outline-secondary" asp-action="Opportunities">Clear</a></div></div></form>
<div class="card shadow-sm border-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Opportunity</th><th>Customer</th><th>Lead</th><th>Stage</th><th>Status</th><th>Amount</th><th>Weighted</th><th>Assigned to</th><th class="text-end">Actions</th></tr></thead><tbody>@if (Model.Opportunities.Count == 0) { <tr><td colspan="9" class="text-center text-secondary py-5">No opportunities match the current filters.</td></tr> } else { @foreach (var item in Model.Opportunities) { <tr><td><a asp-action="OpportunityDetails" asp-route-id="@item.OpportunityId" class="text-decoration-none fw-semibold">@item.OpportunityName</a></td><td>@item.CustomerName</td><td>@(item.LeadName ?? "—")</td><td><span class="badge text-bg-light border">@item.Stage</span></td><td><span class="badge @(item.IsActivePipeline ? "text-bg-primary" : "text-bg-secondary")">@item.Status</span></td><td>@item.Amount.ToString("C")</td><td>@item.WeightedValue.ToString("C")</td><td>@item.AssignedToName</td><td class="text-end text-nowrap"><a asp-action="OpportunityDetails" asp-route-id="@item.OpportunityId" class="btn btn-sm btn-outline-secondary">View</a> <a asp-action="EditOpportunity" asp-route-id="@item.OpportunityId" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="DeleteOpportunity" asp-route-id="@item.OpportunityId" class="btn btn-sm btn-outline-danger">Delete</a></td></tr> } }</tbody></table></div></div>
@if (Model.TotalPages > 1) { <nav class="mt-4"><ul class="pagination justify-content-center">@for (var p = 1; p <= Model.TotalPages; p++) { <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" asp-action="Opportunities" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-stage="@Model.Stage" asp-route-status="@Model.Status" asp-route-assignedTo="@Model.AssignedTo">@p</a></li> }</ul></nav> }
